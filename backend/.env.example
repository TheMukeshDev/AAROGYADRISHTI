# ---------------------------------------------------------------------------
# AarogyaDrishti API - environment template. Copy to `.env` and fill in.
# NEVER commit a real `.env`.
# ---------------------------------------------------------------------------

# Application
APP_NAME="AarogyaDrishti API"
ENVIRONMENT=development          # development | staging | production
DEBUG=true
LOG_LEVEL=INFO
API_V1_PREFIX=/api/v1

# Database (PostgreSQL in production)
# psycopg 3 driver: postgresql+psycopg://USER:PASSWORD@HOST:PORT/DBNAME
DATABASE_URL=postgresql+psycopg://aarogya:aarogya@localhost:5432/aarogyadrishti
DB_ECHO=false
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10

# Authentication (modular: jwt | firebase)
AUTH_PROVIDER=jwt
JWT_SECRET=change-me-to-a-64-char-random-string
JWT_ALGORITHM=HS256
JWT_ISSUER=aarogyadrishti-api
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=30
PASSWORD_RESET_EXPIRE_MINUTES=30
PASSWORD_MIN_LENGTH=8

# Firebase (only needed when AUTH_PROVIDER=firebase)
FIREBASE_PROJECT_ID=
FIREBASE_CREDENTIALS_PATH=

# CORS (comma separated). Use explicit origins in production.
CORS_ORIGINS=http://localhost:8080,http://localhost:3000

# Baseline configuration (Phase 1)
BASELINE_TARGET_DAYS=7
BASELINE_WINDOW_DAYS=14

# Demo/dev-only data seeding. NEVER enable mixing with real accounts.
ALLOW_DEMO_DATA=true
DEMO_ACCOUNT_PREFIX=demo
