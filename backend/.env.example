# ---------------------------------------------------------------------------
# AarogyaDrishti API - environment template. Copy to `.env` and fill in.
# NEVER commit a real `.env`.
#
# Security rule of thumb: `ENVIRONMENT=production` is validated at startup.
# If any of these are still set in production the API refuses to boot:
#   - DEBUG=true                     (exposes /docs, /redoc, openapi.json)
#   - ALLOW_DEMO_DATA=true           (demo account uses a well-known password)
#   - JWT_SECRET=change-me-... or < 32 chars
# ---------------------------------------------------------------------------

# Application
APP_NAME="AarogyaDrishti API"
ENVIRONMENT=development          # development | staging | production
DEBUG=true
LOG_LEVEL=INFO
API_V1_PREFIX=/api/v1

# Database (PostgreSQL in production)
# Locally you may use Docker or a managed PostgreSQL/Supabase database.
# Supabase: use the pooled (Supavisor) URL, which is IPv4-reachable - the
# direct `db.<project-ref>.supabase.co` endpoint is IPv6-only and will NOT
# work from Vercel functions. Schema:
#   postgresql+psycopg://<DB_USER>.<PROJECT_REF>:<PASSWORD>@aws-0-<REGION>.pooler.supabase.com:5432/<DB_NAME>
#   port 5432 = session mode | port 6543 = transaction mode (serverless)
DATABASE_URL=postgresql+psycopg://<USER>:<PASSWORD>@<HOST>:5432/<DATABASE>
DB_ECHO=false
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10

# Supabase REST/Auth (optional - the API uses SQLAlchemy/PostgreSQL for all
# CRUD; these are only needed if a Supabase client is wired in later).
SUPABASE_URL=
SUPABASE_ANON_KEY=

# Authentication (modular: jwt | firebase)
AUTH_PROVIDER=jwt
# REQUIRED for production. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
# >= 32 chars and must NOT equal the committed default.
JWT_SECRET=change-me-to-a-64-char-random-string
JWT_ALGORITHM=HS256
JWT_ISSUER=aarogyadrishti-api
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=30
PASSWORD_RESET_EXPIRE_MINUTES=30
PASSWORD_MIN_LENGTH=8

# Firebase Google sign-in (required when AUTH_PROVIDER=firebase)
# Set AUTH_PROVIDER=firebase to enable the /auth/firebase endpoint.
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_CREDENTIALS_PATH=
# Vercel: copy these values from the Firebase Admin service-account key.
FIREBASE_CLIENT_EMAIL=
# Paste the full key and keep each line break as the two characters `\n`.
FIREBASE_PRIVATE_KEY=
FIREBASE_TOKEN_URI=https://oauth2.googleapis.com/token

# CORS (comma separated). Use explicit origins in production - never "*".
CORS_ORIGINS=http://localhost:8080,http://localhost:3000

# Rate limiting (in-memory per-IP fixed window; per-process)
# Enable in production and also rate-limit at your reverse proxy/gateway.
RATE_LIMIT_ENABLED=false
RATE_LIMIT_GENERAL_PER_MINUTE=120
RATE_LIMIT_AUTH_PER_MINUTE=10
# Set to 1 if one trusted reverse proxy sits in front (uses X-Forwarded-For).
RATE_LIMIT_TRUSTED_PROXY_COUNT=0

# Baseline configuration (Phase 1)
BASELINE_TARGET_DAYS=7
BASELINE_WINDOW_DAYS=14

# Demo/dev-only data seeding. NEVER enable in production - it is refused at
# startup there. Demo accounts share a well-known password.
ALLOW_DEMO_DATA=false
DEMO_ACCOUNT_PREFIX=demo

# AI coach (Phase 6) - never enable a remote provider without a key
AI_PROVIDER=deterministic       # deterministic (offline) | gemini | openai_compatible
AI_API_KEY=
AI_BASE_URL=                    # Gemini default: https://generativelanguage.googleapis.com/v1beta
AI_MODEL=gemini-3.5-flash