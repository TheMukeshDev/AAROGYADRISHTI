<?xml version="1.0" encoding="utf-8"?>
<!--
  Android network security policy.

  Cleartext (plain http) traffic is FORBIDDEN by default so health data can
  never be transmitted unencrypted in production. The only exceptions are the
  loopback/emulator hosts used during local development (10.0.2.2 is the
  Android emulator's alias for the host machine).

  Production builds must point API_BASE_URL at an https:// endpoint:
            flutter build apk release \
    dart-define=API_BASE_URL=https://api.your-domain.in
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system"/>
        </trust-anchors>
    </base-config>

    <!-- Local development only: host machine from the Android emulator. -->
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">10.0.2.2</domain>
        <domain includeSubdomains="false">localhost</domain>
        <domain includeSubdomains="false">127.0.0.1</domain>
    </domain-config>
</network-security-config>